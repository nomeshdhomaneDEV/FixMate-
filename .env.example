# Copy this file to ".env" and change the values.  NEVER commit ".env".
PORT=5000
NODE_ENV=development
# Long random string used to sign JWT tokens
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d
# Address the browser loads the site from (used for CORS)
CLIENT_ORIGIN=http://localhost:5000
# Server-side JSON file database (the repository layer reads/writes this)
DATA_FILE=./data/fixhub.json
